// GENERATED by kg/src/emit.ts from kg/src/l1.ts + kg/src/vocab.ts. Do not edit: change the Zod source and run `npm run build` in kg/.
Logical: KGPublication
Parent: DublinCore
Title: "Knowledge graph L1: Publication"
Description: "A WHO normative publication: a guideline, guidance, recommendation summary, or classification. Metadata follows Dublin Core, which HealthInterventions already uses. publicationType distinguishes normative guideline from guidance from summary table — a summary table restates recommendations made elsewhere, and conflating the two makes provenance wrong. identifier holds ISBN/ISSN/DOI, as CDHIv2 already does. sha256 pins the PDF. Derives from DublinCore (smart-base input/fsh/models/DublinCore.fsh); title, creator, publisher, date, identifier, language, rights are its elements. Class IRI: http://smart.who.int/kg/publication."

* ^status = #active
* ^publisher = "World Health Organization (WHO)"
* version 0..1 string "Version" "Edition or version, as printed."
* url 0..1 uri "URL" "Where the publication is published."
* sha256 0..1 string "SHA-256" "Hash of the PDF the extraction read; pins the source."
* publicationType 0..1 code "Publication type" "Normative guideline, guidance, summary table or classification. Unset when the publication is none of these."
* publicationType from KGPublicationTypeVS (required)

Logical: KGPublicationSection
Title: "Knowledge graph L1: Publication section"
Description: "A chapter, annex or numbered section. Recommendations are located by section and page, which is what makes an extraction checkable. Class IRI: http://smart.who.int/kg/publication-section."

* ^status = #active
* ^publisher = "World Health Organization (WHO)"
* heading 0..1 string "Heading" "The section heading, verbatim."
* number 0..1 string "Number" "The section number as printed (\"1.2\", \"Annex 3\")."
* pageRange 0..1 string "Page range" "PDF page or page range the section occupies (\"12-18\")."

Logical: KGRecommendation
Title: "Knowledge graph L1: Recommendation"
Description: "The atomic normative statement. This is the node nothing in the WHO estate currently makes addressable. statement is a VERBATIM quote, never a paraphrase — a paraphrased recommendation is a new recommendation. strength is GRADE (strong | conditional); certainty is GRADE (high | moderate | low | very-low); conditionality records the 'in settings where…' qualifier that decides whether a DAK can adopt it unchanged. Class IRI: http://smart.who.int/kg/recommendation."

* ^status = #active
* ^publisher = "World Health Organization (WHO)"
* identifier 0..1 string "Identifier" "The recommendation's label or number as printed."
* statement 0..1 markdown "Statement" "The recommendation text, VERBATIM. A paraphrased recommendation is a new recommendation."
* strength 0..1 code "Strength" "GRADE strength, as stated in the source."
* strength from KGGradeStrengthVS (required)
* certainty 0..1 code "Certainty" "GRADE certainty of evidence, as stated in the source."
* certainty from KGGradeCertaintyVS (required)
* conditionality 0..1 string "Conditionality" "The 'in settings where…' qualifier, verbatim, that decides whether a DAK can adopt the recommendation unchanged."
* status 0..1 string "Status" "The recommendation's standing in its publication (for example current or superseded), as stated."

Logical: KGRemark
Title: "Knowledge graph L1: Remark"
Description: "An implementation consideration attached to a recommendation. Grounded: the BCG table's first annotationEntry carries exactly this — \"Neonates born to women of unknown HIV status should be vaccinated as the benefits…\" — clinical nuance that shapes the decision logic but is not the recommendation itself. Class IRI: http://smart.who.int/kg/remark."

* ^status = #active
* ^publisher = "World Health Organization (WHO)"
* text 0..1 markdown "Text" "The implementation consideration, verbatim."

Logical: KGEvidence
Title: "Knowledge graph L1: Evidence"
Description: "The body of evidence behind a recommendation, with its GRADE certainty rating. Class IRI: http://smart.who.int/kg/evidence."

* ^status = #active
* ^publisher = "World Health Organization (WHO)"
* summary 0..1 markdown "Summary" "Summary of the body of evidence."
* certainty 0..1 code "Certainty" "GRADE certainty of the body of evidence."
* certainty from KGGradeCertaintyVS (required)
* studyCount 0..1 unsignedInt "Study count" "Number of studies in the body of evidence."
* citation 0..1 string "Citation" "Bibliographic citation of the evidence review."

