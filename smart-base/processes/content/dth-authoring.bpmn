<?xml version="1.0" encoding="UTF-8"?>
<!--
  smart-base — producing a WHO Digital Transformation Handbook (DTH), from
  sources to publication, in seven stages with recorded milestones
  (smart-base#243).

  Source of truth: this file. The picture beside it (dth-authoring.svg) is
  drawn by `bun run smart-base/scripts/render-processes.ts`; never hand-edit it.

  The <bootstrap.processes:skill> extension on an activity names the skill that
  implements it; <cat-harness.processes:bean> marks a step that writes the
  shared work plan in beans/.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/0.1.0/processes/ns#"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/0.1.0/processes/ns#"
                  id="Definitions_DthAuthoring"
                  targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">

  <bpmn:resource id="programme-manager" name="DTH lead (programme manager)" />
  <bpmn:resource id="work-plan" name="Work plan (beans)" />
  <bpmn:resource id="librarian" name="Librarian" />
  <bpmn:resource id="business-analyst" name="Business analyst" />
  <bpmn:resource id="terminologist" name="Terminologist" />
  <bpmn:resource id="reviewer" name="Architect group and handbook owners" />
  <bpmn:resource id="feedback-provider" name="TWG and contributors" />
  <bpmn:resource id="editor" name="Editor" />
  <bpmn:resource id="publication-manager" name="Publication manager" />

  <bpmn:collaboration id="Collaboration_DthAuthoring">
    <bpmn:participant id="Participant_DthAuthoring" name="WHO Digital Transformation Handbook — from sources to publication" processRef="Process_DthAuthoring" />
  </bpmn:collaboration>

  <bpmn:process id="Process_DthAuthoring" name="DTH authoring" isExecutable="false">
    <bpmn:documentation>Produces a WHO Digital Transformation Handbook (DTH) from its sources to publication, in seven stages that each end in a recorded milestone: initiate (M0 charter), ingest sources into the library (M1 library frozen), outline and scope (M2 outline agreed), structured drafting (M3 zero draft), working-group feedback (M4), public comment (M5 released, M6 dispositioned), and finalise and publish (M7).&#10;Milestones are recorded checkpoints, not gates; review runs beside drafting as QA, as in smart-guideline-end-to-end.bpmn. Structured drafting uses the smart-base DAK block kinds for personas, scenarios, processes, decisions, data elements, indicators and requirements (owner, 2026-10-31: a DTH uses the DAK kinds for its personas and similar content), and each track calls Process_L2ComponentEditReview, as l2-dak-authoring.bpmn does. Contributor feedback from the contributor log sheet and from GitHub pc: comments lands in one review store.&#10;Handbooks ingested from a published WHO PDF (PHC, SC, PC, SFP) enter at stage 1 with their library built and their outline given by the publication; dth-hrh, authored natively, is the pilot. Steps whose platform subprocess does not exist yet are marked as placeholders in their documentation.&#10;Empirical content (figures, statistics, country examples) stays as cited narrative blocks and never enters formal content.</bpmn:documentation>
    <bpmn:extensionElements>
      <cat-harness.processes:policy enforcement="advisory" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="Process_DthAuthoring_LaneSet">
      <bpmn:lane id="Lane_Lead" name="DTH lead (programme manager)" partitionElementRef="programme-manager">
        <bpmn:documentation>Owns the handbook. Sets its scope and its place in the DIIG once, forms the technical working group (TWG), and records the roles and RACI that every later lane is scoped against.</bpmn:documentation>
        <bpmn:flowNodeRef>Start_Requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Team</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WorkPlan" name="Work plan (beans)" partitionElementRef="work-plan">
        <bpmn:documentation>Seeded once from the scope, with one bean per stage and per structured-drafting track, so progress is visible without reading the diagram.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_SeedBeans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Librarian" name="Librarian" partitionElementRef="librarian">
        <bpmn:documentation>Brings every source into the handbook's library/ as received and frozen: WHO publications through who-iris, TWG outlines and workbooks as uploads. Never edits a source to answer a comment.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_Ingest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Coverage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analyst" name="Business analyst" partitionElementRef="business-analyst">
        <bpmn:documentation>Drafts the outline and the structured content. Every structured track uses a smart-base DAK block kind (owner, 2026-10-31: a DTH uses the DAK kinds for its personas and similar content) and calls the shared edit-and-review subprocess.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_Scaffold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Intro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DraftMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DraftFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Personas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Scenarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Bpmn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Dmn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Steps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Archimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Glossary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DraftJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ReviewFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ReviewJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Terminologist" name="Terminologist" partitionElementRef="terminologist">
        <bpmn:documentation>Builds the glossary as a SKOS scheme from the TWG's candidate definitions and links each term to the smart-ra concept it matches or narrows. Never chooses between conflicting definitions; records them as alternatives.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_GlossaryCandidates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Reviewers" name="Architect group and handbook owners" partitionElementRef="reviewer">
        <bpmn:documentation>Review the structured content beside drafting, as QA and not as a gate: the architect group for ArchiMate links and new kinds, the owners of each handbook for content shared with theirs.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_ArchReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Contributors" name="TWG and contributors" partitionElementRef="feedback-provider">
        <bpmn:documentation>Comment through the contributor log sheet or on GitHub (a pc: line in any issue or PR conversation). Both channels land in one review store.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_OutlineReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Comments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublicComments</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Editor" name="Editor" partitionElementRef="editor">
        <bpmn:documentation>Imports comments into the review store, groups them into change sets, decides dispositions, and runs editorial and voice QA.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_Import</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_WgDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenPublic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Disposition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Qa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Publisher" name="Publication manager" partitionElementRef="publication-manager">
        <bpmn:documentation>Publishes the final handbook and, when permitted, hands it to the WHO repository.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Published</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Requested" name="DTH requested">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Scope" name="0 · Scope the DTH and place it in the DIIG&#10;[content-plan]">
      <bpmn:documentation>Name the health-system area, the audience and the DIIG phase the handbook supports, citing the one DIIG phase figure (DIIG section 1.1, Figure 1.1.1). Decide which DTHs and which smart-ra content it builds on.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-plan" />
      </bpmn:extensionElements>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Team" name="Form the TWG; record roles and RACI&#10;[content-plan]">
      <bpmn:documentation>Record who is involved and in which role. Roles are named by id, never free text, so they can bind BPMN lanes later. A RACI kind does not exist yet (smart-base#242 and the structured-authoring decision doc); until it does, the RACI is a table block.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-plan" />
      </bpmn:extensionElements>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_Scaffold" name="Create the DTH repository from the DTH layout&#10;[document-structure]">
      <bpmn:documentation>Declaration, index.config.json (needs smart-ra, and any DTH it mounts), glossary, review store and hooks, copied from dth-hrh's layout. Placeholder: the platform has no subprocess for this yet (smart-base#243); until it exists the step is done by hand, as dth-hrh's was.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="document-structure" />
      </bpmn:extensionElements>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SeedBeans" name="Seed the work plan&#10;[todo-manager]">
      <bpmn:documentation>One bean per stage and per drafting track, children of the handbook's epic.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="todo-manager" />
        <cat-harness.processes:bean />
      </bpmn:extensionElements>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M0" name="Record milestone&#10;M0 · Charter recorded&#10;[todo-manager]">
      <bpmn:documentation>Milestone: repository, declaration, TWG, roles and RACI exist. Recorded, not enforced. It is written as a note on the handbook's epic bean (which milestone, when, evidence), so the site can show stage and progress.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="todo-manager" />
        <cat-harness.processes:bean op="note"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Ingest" name="1 · Ingest sources into library/&#10;[library-ingestion]">
      <bpmn:documentation>Every source as received, frozen: WHO publications through who-iris, the TWG outline and workbooks from uploads/.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="library-ingestion" />
      </bpmn:extensionElements>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L1" name="Extract L1 from WHO publications&#10;[l1-document-ingestion]">
      <bpmn:documentation>Sections, figures, tables and the L1 knowledge graph for each WHO publication the handbook draws on.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="l1-document-ingestion" />
      </bpmn:extensionElements>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Coverage" name="Account for every normative sentence&#10;[l1-coverage]">
      <bpmn:documentation>Each normative sentence is captured or excluded; exclusions are signed by a person, never by the agent that proposed them.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="l1-coverage" />
      </bpmn:extensionElements>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M1" name="Record milestone&#10;M1 · Library frozen&#10;[todo-manager]">
      <bpmn:documentation>Milestone: every source in library/, coverage accounted. Recorded, not enforced. It is written as a note on the handbook's epic bean (which milestone, when, evidence), so the site can show stage and progress.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="todo-manager" />
        <cat-harness.processes:bean op="note"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Outline" name="2 · Outline chapters against the dth kind&#10;[document-structure]">
      <bpmn:documentation>Map the outline onto the dth document kind's sections and report every required section that is missing. dth-hrh's build_from_outline.py is the first instance; a general outline seed does not exist yet. Placeholder: the platform has no subprocess for this yet (smart-base#243); until it exists the step is done by hand, as dth-hrh's was.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="document-structure" />
      </bpmn:extensionElements>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Intro" name="Draft introduction, audience and DIIG alignment&#10;[document-authoring]">
      <bpmn:documentation>The three required opening sections of the dth kind: audience and how to use, DIIG and SMART alignment, health programme context.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="document-authoring" />
      </bpmn:extensionElements>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GlossaryCandidates" name="Build glossary candidates from the TWG workbook&#10;[terminology-management]">
      <bpmn:documentation>One SKOS candidate per (concept, source); only a person moves a term to authored.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="terminology-management" />
      </bpmn:extensionElements>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Inventory" name="List processes, roles, decisions and indicators to model&#10;[content-plan]">
      <bpmn:documentation>The inventory that seeds the structured-drafting tracks: each business process becomes BPMN, each role a structured block, each stated decision rule a DMN table.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-plan" />
      </bpmn:extensionElements>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_OutlineReview" name="TWG reviews the outline&#10;[content-feedback]">
      <bpmn:documentation>First contributor-feedback round, through the contributor log sheet and GitHub.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-feedback" />
      </bpmn:extensionElements>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="M2" name="Record milestone&#10;M2 · Outline agreed&#10;[todo-manager]">
      <bpmn:documentation>Milestone: the outline's round-1 comments are dispositioned. Recorded, not enforced. It is written as a note on the handbook's epic bean (which milestone, when, evidence), so the site can show stage and progress.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="todo-manager" />
        <cat-harness.processes:bean op="note"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_DraftMerge">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F44</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="GW_DraftFork" name="3 · Structured drafting">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Call_Personas" name="Personas and roles&#10;[l2-dak-authoring]" calledElement="Process_L2ComponentEditReview">
      <bpmn:documentation>Persona and actor-definition blocks; organisational roles and governance bodies as their own kind once it exists. Calls Process_L2ComponentEditReview: the agent edits, checks, renders and stages; a person in the reviewing role reviews alongside, never as a gate.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="l2-dak-authoring" />
        <bootstrap.processes:skill ref="l2-component-edit-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Scenarios" name="User scenarios&#10;[l2-dak-authoring]" calledElement="Process_L2ComponentEditReview">
      <bpmn:documentation>User-scenario blocks naming their personas by id. Calls Process_L2ComponentEditReview: the agent edits, checks, renders and stages; a person in the reviewing role reviews alongside, never as a gate.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="l2-dak-authoring" />
        <bootstrap.processes:skill ref="l2-component-edit-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Bpmn" name="Business processes · BPMN&#10;[bpmn-authoring]" calledElement="Process_L2ComponentEditReview">
      <bpmn:documentation>One BPMN per business process; every lane bound to a persona or role id. Calls Process_L2ComponentEditReview: the agent edits, checks, renders and stages; a person in the reviewing role reviews alongside, never as a gate.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="bpmn-authoring" />
        <bootstrap.processes:skill ref="l2-component-edit-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Dmn" name="Decision tables · DMN&#10;[dmn-authoring]" calledElement="Process_L2ComponentEditReview">
      <bpmn:documentation>Only rules the text states. A decision the text names without a rule is recorded as a decision point, not filled in. Calls Process_L2ComponentEditReview: the agent edits, checks, renders and stages; a person in the reviewing role reviews alongside, never as a gate.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="dmn-authoring" />
        <bootstrap.processes:skill ref="l2-component-edit-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Data" name="Data elements, indicators, requirements&#10;[l2-dak-authoring]" calledElement="Process_L2ComponentEditReview">
      <bpmn:documentation>data-element, indicator, functional and non-functional requirement blocks, with their fields as data rather than Markdown tables. Calls Process_L2ComponentEditReview: the agent edits, checks, renders and stages; a person in the reviewing role reviews alongside, never as a gate.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="l2-dak-authoring" />
        <bootstrap.processes:skill ref="l2-component-edit-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Steps" name="Planning steps per chapter&#10;[document-authoring]" calledElement="Process_L2ComponentEditReview">
      <bpmn:documentation>Each chapter's inputs, steps, resources, outputs, risks and mitigations as the shared step table (smart-base#242). Calls Process_L2ComponentEditReview: the agent edits, checks, renders and stages; a person in the reviewing role reviews alongside, never as a gate.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="document-authoring" />
        <bootstrap.processes:skill ref="l2-component-edit-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Archimate" name="Link to smart-ra ArchiMate&#10;[archimate-models]" calledElement="Process_L2ComponentEditReview">
      <bpmn:documentation>Every block that names an architecture element links to its smart-ra element or view; new elements go to smart-ra, not the handbook. Placeholder: the platform has no subprocess for this yet (smart-base#243); until it exists the step is done by hand, as dth-hrh's was. Calls Process_L2ComponentEditReview: the agent edits, checks, renders and stages; a person in the reviewing role reviews alongside, never as a gate.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="archimate-models" />
        <bootstrap.processes:skill ref="l2-component-edit-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Glossary" name="Link glossary to smart-ra SKOS&#10;[terminology-management]" calledElement="Process_L2ComponentEditReview">
      <bpmn:documentation>Each handbook term is exactMatch, closeMatch or narrower to a smart-ra concept; conflicts are raised as issues on smart-ra. Calls Process_L2ComponentEditReview: the agent edits, checks, renders and stages; a person in the reviewing role reviews alongside, never as a gate.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="terminology-management" />
        <bootstrap.processes:skill ref="l2-component-edit-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="GW_DraftJoin">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="GW_ReviewFork">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Validate" name="Validate the draft&#10;[content-validate]">
      <bpmn:documentation>Every structured block validates against its kind; required dth sections present; no unlinked architecture names; no empirical claims in formal content.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-validate" />
      </bpmn:extensionElements>
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ArchReview" name="Architect group and handbook owners review&#10;[content-review]">
      <bpmn:documentation>Runs beside validation, as QA. New kinds and shared schemas are reviewed here before they are built.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="GW_ReviewJoin">
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="M3" name="Record milestone&#10;M3 · Zero draft&#10;[todo-manager]">
      <bpmn:documentation>Milestone: every required section drafted and every structured block validates. Recorded, not enforced. It is written as a note on the handbook's epic bean (which milestone, when, evidence), so the site can show stage and progress.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="todo-manager" />
        <cat-harness.processes:bean op="note"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_Comments" name="4 · Comment via contributor log sheet or GitHub pc:&#10;[content-feedback]">
      <bpmn:documentation>The contributor log (Google Sheet) and pc: lines on GitHub issues and PRs.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-feedback" />
      </bpmn:extensionElements>
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F41</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_Import" name="Import into review/wg-comment and form change sets&#10;[public-comment]">
      <bpmn:documentation>public-comment import --store review/wg-comment; change sets group comments that change the same text.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="public-comment" />
      </bpmn:extensionElements>
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:outgoing>F42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_WgDone" name="All working-group comments dispositioned?">
      <bpmn:incoming>F42</bpmn:incoming>
      <bpmn:outgoing>F43</bpmn:outgoing>
      <bpmn:outgoing>F44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M4" name="Record milestone&#10;M4 · Working-group draft&#10;[todo-manager]">
      <bpmn:documentation>Milestone: all working-group comments dispositioned. Recorded, not enforced. It is written as a note on the handbook's epic bean (which milestone, when, evidence), so the site can show stage and progress.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="todo-manager" />
        <cat-harness.processes:bean op="note"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:outgoing>F45</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OpenPublic" name="5 · Open public comment&#10;[public-comment]">
      <bpmn:documentation>A separate store, review/public-comment, and the public-comment review sheet.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="public-comment" />
      </bpmn:extensionElements>
      <bpmn:incoming>F45</bpmn:incoming>
      <bpmn:outgoing>F46</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M5" name="Record milestone&#10;M5 · Public draft released&#10;[todo-manager]">
      <bpmn:documentation>Milestone: the public draft is out for comment. It is written as a note on the handbook's epic bean (which milestone, when, evidence), so the site can show stage and progress.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="todo-manager" />
        <cat-harness.processes:bean op="note"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F46</bpmn:incoming>
      <bpmn:outgoing>F47</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_PublicComments" name="Public comments&#10;[content-feedback]">
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-feedback" />
      </bpmn:extensionElements>
      <bpmn:incoming>F47</bpmn:incoming>
      <bpmn:outgoing>F48</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_Disposition" name="Disposition comments and apply change sets&#10;[public-comment]">
      <bpmn:documentation>Changes to structured content go back through its kind's edit-and-review subprocess.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="public-comment" />
      </bpmn:extensionElements>
      <bpmn:incoming>F48</bpmn:incoming>
      <bpmn:outgoing>F49</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M6" name="Record milestone&#10;M6 · Comments dispositioned&#10;[todo-manager]">
      <bpmn:documentation>Milestone: every public comment dispositioned. It is written as a note on the handbook's epic bean (which milestone, when, evidence), so the site can show stage and progress.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="todo-manager" />
        <cat-harness.processes:bean op="note"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F49</bpmn:incoming>
      <bpmn:outgoing>F50</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Qa" name="6 · Editorial, voice and translation QA&#10;[quality-control]">
      <bpmn:documentation>The DTH voice (smart-base skills/voices/who-digital-transformation-handbook), figures and translations.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="quality-control" />
      </bpmn:extensionElements>
      <bpmn:incoming>F50</bpmn:incoming>
      <bpmn:outgoing>F51</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Publish" name="Publish the handbook&#10;[document-publishing]">
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="document-publishing" />
      </bpmn:extensionElements>
      <bpmn:incoming>F51</bpmn:incoming>
      <bpmn:outgoing>F52</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Published" name="M7 · Final published">
      <bpmn:incoming>F52</bpmn:incoming>
    </bpmn:endEvent>
