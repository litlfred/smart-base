<?xml version="1.0" encoding="UTF-8"?>
<!--
  folio-assistant — a WHO SMART Guidelines use case, end to end: L1 knowledge
  graph, L2 DAK, L3 FHIR IG, consuming application, new or adapted.

  Source of truth: this file. Open it in bpmn.io, Camunda Modeler, or any other
  BPMN 2.0 tool. The SVG under docs/assets/img/workflows/ is generated from it
  by `bun run render:bpmn` — never hand-edit the SVG.

  The <bootstrap.processes:skill> extension on an activity names the folio-assistant skill
  that implements it.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/0.1.0/processes/ns#"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/0.1.0/processes/ns#"
                  id="Definitions_SgEndToEnd"
                  targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">

  <bpmn:collaboration id="Collaboration_SgEndToEnd">
    <bpmn:participant id="Participant_SgEndToEnd" name="WHO SMART Guidelines — end to end, authoring or adaptation" processRef="Process_SgEndToEnd" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SgEndToEnd" name="SMART Guideline end to end" isExecutable="false">
    <bpmn:documentation>From a use case to a consuming application: identify the L1 guidelines, ingest them into an L1 knowledge graph, choose the L2 DAKs to build on, create or adapt the L2 assets, choose the L3 IGs to build on, produce the L3 assets, then build the application the requester describes. Adjudication follows every stage as QA, not as a gate (owner, 2026-10-14: "once agent produces L2 it can produce L3"): each stage forks into the next stage and its adjudication, and each adjudication has its own end event, so the instance completes only when all are recorded. The stages run the existing skills and processes (l2-dak-authoring.bpmn for stage 4, dak-l3-ig.bpmn for stage 6); the smart-guideline-end-to-end skill says which, and who adjudicates each.</bpmn:documentation>
    <bpmn:extensionElements>
      <cat-harness.processes:policy enforcement="advisory" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="Process_SgEndToEnd_LaneSet">
      <bpmn:lane id="Lane_User" name="Requester (country team / implementer)">
        <bpmn:documentation>The person who wants the guideline and the application. Describes the use case (stage 0) and the consuming application (stage 7). The agent asks; it never invents either.</bpmn:documentation>
        <bpmn:extensionElements><bootstrap.processes:role ref="user"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>StartEvent_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DescribeUseCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DescribeApp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Authoring agent">
        <bpmn:documentation>Runs every authoring stage with the skill named on each activity. Goes straight on to the next stage after each one: adjudication runs beside it, as QA, not as a gate (owner, 2026-10-14).</bpmn:documentation>
        <bpmn:extensionElements><bootstrap.processes:role ref="authoring-agent"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>Task_IdentifyL1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_L1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InKg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IngestKg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_Kg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KgMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DepsL2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_DepsL2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_L2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DepsL3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_DepsL3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_L3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WireframeApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_App</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AppBuilt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Adjudicators" name="Human adjudicators">
        <bpmn:documentation>Clinical SME, l1-extraction-reviewer, programme manager, business analyst, FHIR modeller, terminologist: which one signs each stage is in the smart-guideline-end-to-end skill. Each adjudication calls cat-harness's generic review, Process_Review, on the staged preview (feature-staging, staging-review) and records a qa-review/v1 Decision (approve, request-changes, reject) with the adjudicator's role id. Each adjudication ends in its own end event, so the instance is complete only when every adjudication is recorded. A rejection files a bean against the stage and marks every downstream asset derived from the rejected item rejected-upstream; it does not stop the agent.</bpmn:documentation>
        <bpmn:extensionElements><bootstrap.processes:role ref="reviewer"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>Task_AdjL1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjKg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjDepsL2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjL2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjDepsL3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjL3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AdjL1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AdjKg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AdjDepsL2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AdjL2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AdjDepsL3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AdjL3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AdjApp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Need" name="Use case to support">
      <bpmn:documentation>Someone needs a SMART Guideline, new or adapted, for a use case.</bpmn:documentation>
      <bpmn:outgoing>E01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_DescribeUseCase" name="0 · Describe the use case">
      <bpmn:documentation>Population, setting, jurisdiction, interventions in scope. The user's own words; the agent asks a numbered question if the request did not say.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="smart-guideline-end-to-end" />
      </bpmn:extensionElements>
      <bpmn:incoming>E01</bpmn:incoming>
      <bpmn:outgoing>E02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_IdentifyL1" name="1 · Identify L1 guidelines and recommendations&#10;[dak-l1-library]">
      <bpmn:documentation>Component 1 sources of any DAK already in scope first, then WHO IRIS and the jurisdiction's own guidelines. Each candidate marked in-library / in-KG / not yet.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="dak-l1-library" />
        <bootstrap.processes:skill ref="smart-guideline-end-to-end" />
      </bpmn:extensionElements>
      <bpmn:incoming>E02</bpmn:incoming>
      <bpmn:outgoing>E03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Fork_L1">
      <bpmn:incoming>E03</bpmn:incoming>
      <bpmn:outgoing>E04</bpmn:outgoing>
      <bpmn:outgoing>E05</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Task_AdjL1" name="Adjudicate the L1 source list" calledElement="Process_Review">
      <bpmn:documentation>Clinical SME: each source with why it was included or left out.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>E04</bpmn:incoming>
      <bpmn:outgoing>E29</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_InKg" name="All sources in an L1 KG?">
      <bpmn:incoming>E05</bpmn:incoming>
      <bpmn:outgoing>E06</bpmn:outgoing>
      <bpmn:outgoing>E07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_IngestKg" name="2 · Ingest into the L1 KG&#10;[dak-l1-library · recommendation-extraction]">
      <bpmn:documentation>Per source not yet extracted: cat ingest into library/, the generic-document layer (l1-library), then the L1 layer (recommendations, remarks, practices, scenario candidates) into library/&lt;bib&gt;/l1-extraction/.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="dak-l1-library" />
        <bootstrap.processes:skill ref="recommendation-extraction" />
      </bpmn:extensionElements>
      <bpmn:incoming>E06</bpmn:incoming>
      <bpmn:outgoing>E08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Fork_Kg">
      <bpmn:incoming>E08</bpmn:incoming>
      <bpmn:outgoing>E09</bpmn:outgoing>
      <bpmn:outgoing>E10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Task_AdjKg" name="Adjudicate the L1 KG" calledElement="Process_Review">
      <bpmn:documentation>l1-extraction-reviewer signs exclusions and coverage; Clinical SME reviews recommendations beside the printed page.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-review" />
        <bootstrap.processes:skill ref="recommendation-extraction" />
      </bpmn:extensionElements>
      <bpmn:incoming>E09</bpmn:incoming>
      <bpmn:outgoing>E30</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_KgMerge">
      <bpmn:incoming>E07</bpmn:incoming>
      <bpmn:incoming>E10</bpmn:incoming>
      <bpmn:outgoing>E11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DepsL2" name="3 · Choose L2 dependencies&#10;(WHO / jurisdiction DAKs)">
      <bpmn:documentation>From the L1 KG: which existing DAKs to reuse, adapt, extend or reject, each with evidence and reason. Reuse first; prefer the jurisdiction's adaptation, recording the WHO original as its upstream.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="smart-guideline-end-to-end" />
        <bootstrap.processes:skill ref="decision-comparison" />
      </bpmn:extensionElements>
      <bpmn:incoming>E11</bpmn:incoming>
      <bpmn:outgoing>E12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Fork_DepsL2">
      <bpmn:incoming>E12</bpmn:incoming>
      <bpmn:outgoing>E13</bpmn:outgoing>
      <bpmn:outgoing>E14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Task_AdjDepsL2" name="Adjudicate L2 dependencies" calledElement="Process_Review">
      <bpmn:documentation>Programme manager and business analyst: one row per candidate DAK, rejected ones included.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-review" />
        <bootstrap.processes:skill ref="decision-audit" />
      </bpmn:extensionElements>
      <bpmn:incoming>E13</bpmn:incoming>
      <bpmn:outgoing>E31</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="Task_L2" name="4 · Create / adapt L2 DAK assets&#10;[l2-dak-authoring]">
      <bpmn:documentation>The authoring steps of l2-dak-authoring.bpmn (personas and scenarios, BPMN, DMN, data dictionary, indicators and requirements, terminology), plus the design of each data-entry form as wireframe candidates (wireframe-design-review, design use) from the persona, the user scenario and the core data elements. Its clinical validation is this stage's adjudication and does not hold up stage 5. The IG is built through fhir-harness's AST cache lifecycle (ig-ast-refresh.yml), with the DAK pre-processing as smart-base's pre-export overlay (dak-preprocessing, dak-pre-export.sh) and the DAK sidecars made from the AST (dak-postprocessing).</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="l2-dak-authoring" />
        <bootstrap.processes:skill ref="dak-preprocessing" />
        <bootstrap.processes:skill ref="dak-postprocessing" />
        <bootstrap.processes:skill ref="wireframe-design-review" />
        <bootstrap.processes:skill ref="feature-staging" />
      </bpmn:extensionElements>
      <bpmn:incoming>E14</bpmn:incoming>
      <bpmn:outgoing>E15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Fork_L2">
      <bpmn:incoming>E15</bpmn:incoming>
      <bpmn:outgoing>E16</bpmn:outgoing>
      <bpmn:outgoing>E17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Task_AdjL2" name="Review each L2 asset&#10;(before / after if adapted)" calledElement="Process_Review">
      <bpmn:documentation>One review item per created or changed asset, shown as its reviewer reads it (diagram, table, data-dictionary rows); each form's wireframe candidates are reviewed blind and one is chosen (Process_Adjudication, Process_OptionsAnalysis); an adapted asset as a diff against its pinned upstream.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-review" />
        <bootstrap.processes:skill ref="staging-review" />
        <bootstrap.processes:skill ref="visual-diff" />
        <bootstrap.processes:skill ref="wireframe-design-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>E16</bpmn:incoming>
      <bpmn:outgoing>E32</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="Task_DepsL3" name="5 · Choose L3 dependencies&#10;(WHO / jurisdiction IGs)&#10;[ig-artifact-ingestion]">
      <bpmn:documentation>Index each candidate IG, then match the L1 KG and the L2 assets against it: reuse, adapt, extend or reject per IG.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="ig-artifact-ingestion" />
        <bootstrap.processes:skill ref="decision-comparison" />
      </bpmn:extensionElements>
      <bpmn:incoming>E17</bpmn:incoming>
      <bpmn:outgoing>E18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Fork_DepsL3">
      <bpmn:incoming>E18</bpmn:incoming>
      <bpmn:outgoing>E19</bpmn:outgoing>
      <bpmn:outgoing>E20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Task_AdjDepsL3" name="Adjudicate L3 dependencies" calledElement="Process_Review">
      <bpmn:documentation>FHIR modeller and terminologist: one row per candidate IG, rejected ones included.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-review" />
        <bootstrap.processes:skill ref="decision-audit" />
      </bpmn:extensionElements>
      <bpmn:incoming>E19</bpmn:incoming>
      <bpmn:outgoing>E33</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="Task_L3" name="6 · Produce L3 assets&#10;[l3-fhir-authoring]">
      <bpmn:documentation>The mapping and pipeline of dak-l3-ig.bpmn, up to a clean IG build. Each Questionnaire is derived from the chosen L2 wireframe of its form. Publication continues in that process and is not on the path to stage 8.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="l3-fhir-authoring" />
        <bootstrap.processes:skill ref="l2-dak-authoring" />
        <bootstrap.processes:skill ref="feature-staging" />
      </bpmn:extensionElements>
      <bpmn:incoming>E20</bpmn:incoming>
      <bpmn:outgoing>E21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Fork_L3">
      <bpmn:incoming>E21</bpmn:incoming>
      <bpmn:outgoing>E22</bpmn:outgoing>
      <bpmn:outgoing>E23</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Task_AdjL3" name="Review each L3 asset&#10;(before / after if adapted)" calledElement="Process_Review">
      <bpmn:documentation>One review item per created or changed resource: differential, each Questionnaire against the L2 wireframe it was derived from (field to item: fhir-harness fhir-questionnaire-wireframe, whose check is check-wireframe-questionnaire), CQL beside its DMN rule with test results, terminology expansions.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-review" />
        <bootstrap.processes:skill ref="staging-review" />
        <bootstrap.processes:skill ref="ig-ast-delta" />
        <bootstrap.processes:skill ref="wireframe-design-review" />
        <bootstrap.processes:skill ref="fhir-questionnaire-wireframe" />
      </bpmn:extensionElements>
      <bpmn:incoming>E22</bpmn:incoming>
      <bpmn:outgoing>E34</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="Task_DescribeApp" name="7 · Describe the consuming application">
      <bpmn:documentation>Who uses it, on what device, which L2 processes and L3 resources it covers, connectivity, the systems it talks to. The agent offers options drawn from the L2 personas and processes. This is the written intent wireframe-design-review starts from.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="smart-guideline-end-to-end" />
      </bpmn:extensionElements>
      <bpmn:incoming>E23</bpmn:incoming>
      <bpmn:outgoing>E24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_WireframeApp" name="8a · Wireframe the application&#10;[wireframe-design-review]">
      <bpmn:documentation>To-be mode, from the stage-7 intent: two or more candidates, web and mobile, with real content from the L2 personas and scenarios. The agent goes on with its recommended candidate; the requester may choose another during adjudication.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="wireframe-design-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>E24</bpmn:incoming>
      <bpmn:outgoing>E25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BuildApp" name="8b · Build the consuming application">
      <bpmn:documentation>Against the stage-6 IG build, with conformance tests from the IG's examples and test cases.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="smart-guideline-end-to-end" />
      </bpmn:extensionElements>
      <bpmn:incoming>E25</bpmn:incoming>
      <bpmn:outgoing>E26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Fork_App">
      <bpmn:incoming>E26</bpmn:incoming>
      <bpmn:outgoing>E27</bpmn:outgoing>
      <bpmn:outgoing>E28</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Task_AdjApp" name="Adjudicate the wireframes and the application" calledElement="Process_Review">
      <bpmn:documentation>Business analyst and clinical SME walk it through each L2 user scenario; FHIR modeller checks L3 conformance.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-review" />
        <bootstrap.processes:skill ref="staging-review" />
        <bootstrap.processes:skill ref="wireframe-design-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>E27</bpmn:incoming>
      <bpmn:outgoing>E35</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_AppBuilt" name="Application built">
      <bpmn:incoming>E28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_AdjL1" name="Adjudicated">
      <bpmn:incoming>E29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_AdjKg" name="Adjudicated">
      <bpmn:incoming>E30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_AdjDepsL2" name="Adjudicated">
      <bpmn:incoming>E31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_AdjL2" name="Adjudicated">
      <bpmn:incoming>E32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_AdjDepsL3" name="Adjudicated">
      <bpmn:incoming>E33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_AdjL3" name="Adjudicated">
      <bpmn:incoming>E34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_AdjApp" name="Adjudicated">
      <bpmn:incoming>E35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="E01" sourceRef="StartEvent_Need" targetRef="Task_DescribeUseCase" />
    <bpmn:sequenceFlow id="E02" sourceRef="Task_DescribeUseCase" targetRef="Task_IdentifyL1" />
    <bpmn:sequenceFlow id="E03" sourceRef="Task_IdentifyL1" targetRef="Fork_L1" />
    <bpmn:sequenceFlow id="E04" sourceRef="Fork_L1" targetRef="Task_AdjL1" />
    <bpmn:sequenceFlow id="E05" sourceRef="Fork_L1" targetRef="Gateway_InKg" />
    <bpmn:sequenceFlow id="E06" name="no" sourceRef="Gateway_InKg" targetRef="Task_IngestKg" />
    <bpmn:sequenceFlow id="E07" name="yes" sourceRef="Gateway_InKg" targetRef="Gateway_KgMerge" />
    <bpmn:sequenceFlow id="E08" sourceRef="Task_IngestKg" targetRef="Fork_Kg" />
    <bpmn:sequenceFlow id="E09" sourceRef="Fork_Kg" targetRef="Task_AdjKg" />
    <bpmn:sequenceFlow id="E10" sourceRef="Fork_Kg" targetRef="Gateway_KgMerge" />
    <bpmn:sequenceFlow id="E11" sourceRef="Gateway_KgMerge" targetRef="Task_DepsL2" />
    <bpmn:sequenceFlow id="E12" sourceRef="Task_DepsL2" targetRef="Fork_DepsL2" />
    <bpmn:sequenceFlow id="E13" sourceRef="Fork_DepsL2" targetRef="Task_AdjDepsL2" />
    <bpmn:sequenceFlow id="E14" sourceRef="Fork_DepsL2" targetRef="Task_L2" />
    <bpmn:sequenceFlow id="E15" sourceRef="Task_L2" targetRef="Fork_L2" />
    <bpmn:sequenceFlow id="E16" sourceRef="Fork_L2" targetRef="Task_AdjL2" />
    <bpmn:sequenceFlow id="E17" sourceRef="Fork_L2" targetRef="Task_DepsL3" />
    <bpmn:sequenceFlow id="E18" sourceRef="Task_DepsL3" targetRef="Fork_DepsL3" />
