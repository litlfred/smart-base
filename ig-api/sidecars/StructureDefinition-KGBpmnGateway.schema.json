{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/base/StructureDefinition-KGBpmnGateway.schema.json",
  "title": "Knowledge graph L2-BPMN: BPMN Gateway",
  "description": "A branch or merge. Included for connectivity rather than for a cross-model edge: a flow through a gateway with no node would point at nothing, and every reachability question over the process would break at the first decision point. Class IRI: http://smart.who.int/kg/bpmn-gateway.",
  "type": "object",
  "properties": {
    "resourceType": {
      "type": "string",
      "const": "KGBpmnGateway",
      "description": "Resource type identifier for KGBpmnGateway logical model"
    },
    "@context": {
      "description": "JSON-LD context for this logical model with ValueSet vocabularies",
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "description": "URI reference to external JSON-LD context"
        },
        {
          "type": "object",
          "description": "Inline JSON-LD context",
          "properties": {
            "@version": {
              "type": "number",
              "const": 1.1
            },
            "fhir": {
              "type": "string",
              "const": "http://hl7.org/fhir/"
            }
          },
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        },
        {
          "type": "array",
          "description": "Array of JSON-LD context objects/URIs",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      ]
    },
    "@type": {
      "type": "string",
      "description": "JSON-LD type identifier for KGBpmnGateway logical model",
      "examples": [
        "LogicalModel-KGBpmnGateway"
      ]
    },
    "id": {
      "type": "string",
      "description": "The identifier the source declares (an FSH instance id, a BPMN or DMN element id)."
    },
    "name": {
      "type": "string",
      "description": "The computable name: the CamelCase identifier a Canonical() reference matches on."
    },
    "gatewayType": {
      "type": "string",
      "description": "The BPMN gateway element type (exclusiveGateway, parallelGateway, …)."
    },
    "direction": {
      "$ref": "./ValueSet-KGGatewayDirectionVS.schema.json",
      "description": "The gateway's gatewayDirection."
    }
  },
  "required": [
    "resourceType"
  ],
  "allOf": [
    {
      "$ref": "./StructureDefinition-FHIRSchemaBase.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "resourceDefinition": {
          "type": "string",
          "format": "uri",
          "const": "http://smart.who.int/base/StructureDefinition/KGBpmnGateway"
        },
        "fhir:parent": {
          "type": "string",
          "const": "http://hl7.org/fhir/StructureDefinition/Base"
        },
        "jsonld:valuesets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "const": [
            "KGGatewayDirectionVS"
          ]
        },
        "jsonld:contextTemplate": {
          "type": "object",
          "const": {
            "@version": 1.1,
            "fhir": "http://hl7.org/fhir/",
            "KGGatewayDirectionVS": "http://smart.who.int/base/ValueSet-KGGatewayDirectionVS.jsonld"
          }
        }
      }
    }
  ]
}