{
  "openapi": "3.0.3",
  "info": {
    "title": "Knowledge graph L1: Citation API",
    "description": "One citation string exactly as written in a DAK artefact. A cell holding several citations yields several nodes. Content-addressed in the DAK's namespace, so one string is one node across artefacts. Where a citation was found is recorded by appearsIn (L2) and by each use edge (L2-DMN, L3 citesSource), not on the node. Class IRI: http://smart.who.int/kg/citation.",
    "version": "1.0.0"
  },
  "paths": {
    "/StructureDefinition-KGCitation.schema.json": {
      "get": {
        "summary": "JSON Schema definition for the Logical Model StructureDefinition-KGCitation",
        "description": "This endpoint serves the JSON Schema definition for the Logical Model StructureDefinition-KGCitation.",
        "responses": {
          "200": {
            "description": "The JSON Schema for StructureDefinition-KGCitation",
            "content": {
              "application/schema+json": {
                "schema": {
                  "$ref": "./StructureDefinition-KGCitation.schema.json"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StructureDefinition-KGCitation": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "http://smart.who.int/base/StructureDefinition-KGCitation.schema.json",
        "title": "Knowledge graph L1: Citation",
        "description": "One citation string exactly as written in a DAK artefact. A cell holding several citations yields several nodes. Content-addressed in the DAK's namespace, so one string is one node across artefacts. Where a citation was found is recorded by appearsIn (L2) and by each use edge (L2-DMN, L3 citesSource), not on the node. Class IRI: http://smart.who.int/kg/citation.",
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "const": "KGCitation",
            "description": "Resource type identifier for KGCitation logical model"
          },
          "@context": {
            "description": "JSON-LD context for this logical model with ValueSet vocabularies",
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "description": "URI reference to external JSON-LD context"
              },
              {
                "type": "object",
                "description": "Inline JSON-LD context",
                "properties": {
                  "@version": {
                    "type": "number",
                    "const": 1.1
                  },
                  "fhir": {
                    "type": "string",
                    "const": "http://hl7.org/fhir/"
                  }
                },
                "additionalProperties": {
                  "type": "string",
                  "format": "uri"
                }
              },
              {
                "type": "array",
                "description": "Array of JSON-LD context objects/URIs",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              }
            ]
          },
          "@type": {
            "type": "string",
            "description": "JSON-LD type identifier for KGCitation logical model",
            "examples": [
              "LogicalModel-KGCitation"
            ]
          },
          "text": {
            "type": "string",
            "description": "The citation string, VERBATIM, as written in the DAK artefact."
          },
          "numbering": {
            "type": "string",
            "description": "The '(n)' back-reference into the artefact's reference list."
          },
          "citationKind": {
            "oneOf": [
              {
                "type": "string",
                "description": "Code from ValueSet KGCitationKindVS (plain string)"
              },
              {
                "type": "object",
                "description": "Code from ValueSet KGCitationKindVS (JSON-LD structure)",
                "properties": {
                  "@type": {
                    "type": "string",
                    "const": "http://smart.who.int/base/ValueSet-KGCitationKindVS.jsonld",
                    "description": "JSON-LD type reference to ValueSet KGCitationKindVS"
                  },
                  "@id": {
                    "type": "string",
                    "format": "uri",
                    "description": "Full IRI of the code from ValueSet KGCitationKindVS"
                  }
                },
                "required": [
                  "@type",
                  "@id"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Whether a citation string names a source, or stands in for one that is missing."
          },
          "resolutionStatus": {
            "oneOf": [
              {
                "type": "string",
                "description": "Code from ValueSet KGResolutionStatusVS (plain string)"
              },
              {
                "type": "object",
                "description": "Code from ValueSet KGResolutionStatusVS (JSON-LD structure)",
                "properties": {
                  "@type": {
                    "type": "string",
                    "const": "http://smart.who.int/base/ValueSet-KGResolutionStatusVS.jsonld",
                    "description": "JSON-LD type reference to ValueSet KGResolutionStatusVS"
                  },
                  "@id": {
                    "type": "string",
                    "format": "uri",
                    "description": "Full IRI of the code from ValueSet KGResolutionStatusVS"
                  }
                },
                "required": [
                  "@type",
                  "@id"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Whether a citation string has been matched to what it cites."
          }
        },
        "required": [
          "resourceType"
        ],
        "resourceDefinition": "http://smart.who.int/base/StructureDefinition/KGCitation",
        "fhir:parent": "http://hl7.org/fhir/StructureDefinition/Base",
        "jsonld:valuesets": [
          "KGResolutionStatusVS",
          "KGCitationKindVS"
        ],
        "jsonld:contextTemplate": {
          "@version": 1.1,
          "fhir": "http://hl7.org/fhir/",
          "KGResolutionStatusVS": "http://smart.who.int/base/ValueSet-KGResolutionStatusVS.jsonld",
          "KGCitationKindVS": "http://smart.who.int/base/ValueSet-KGCitationKindVS.jsonld"
        }
      }
    }
  }
}