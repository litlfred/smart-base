{
  "openapi": "3.0.3",
  "info": {
    "title": "Knowledge graph L1: Evidence API",
    "description": "One row of an evidence profile: the evidence for one outcome of one key question, with its certainty (handbook §9.2). Class IRI: http://smart.who.int/kg/evidence.",
    "version": "1.0.0"
  },
  "paths": {
    "/StructureDefinition-KGEvidence.schema.json": {
      "get": {
        "summary": "JSON Schema definition for the Logical Model StructureDefinition-KGEvidence",
        "description": "This endpoint serves the JSON Schema definition for the Logical Model StructureDefinition-KGEvidence.",
        "responses": {
          "200": {
            "description": "The JSON Schema for StructureDefinition-KGEvidence",
            "content": {
              "application/schema+json": {
                "schema": {
                  "$ref": "./StructureDefinition-KGEvidence.schema.json"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StructureDefinition-KGEvidence": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "http://smart.who.int/base/StructureDefinition-KGEvidence.schema.json",
        "title": "Knowledge graph L1: Evidence",
        "description": "One row of an evidence profile: the evidence for one outcome of one key question, with its certainty (handbook §9.2). Class IRI: http://smart.who.int/kg/evidence.",
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "const": "KGEvidence",
            "description": "Resource type identifier for KGEvidence logical model"
          },
          "@context": {
            "description": "JSON-LD context for this logical model with ValueSet vocabularies",
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "description": "URI reference to external JSON-LD context"
              },
              {
                "type": "object",
                "description": "Inline JSON-LD context",
                "properties": {
                  "@version": {
                    "type": "number",
                    "const": 1.1
                  },
                  "fhir": {
                    "type": "string",
                    "const": "http://hl7.org/fhir/"
                  }
                },
                "additionalProperties": {
                  "type": "string",
                  "format": "uri"
                }
              },
              {
                "type": "array",
                "description": "Array of JSON-LD context objects/URIs",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              }
            ]
          },
          "@type": {
            "type": "string",
            "description": "JSON-LD type identifier for KGEvidence logical model",
            "examples": [
              "LogicalModel-KGEvidence"
            ]
          },
          "evidenceType": {
            "oneOf": [
              {
                "type": "string",
                "description": "Code from ValueSet KGEvidenceTypeVS (plain string)"
              },
              {
                "type": "object",
                "description": "Code from ValueSet KGEvidenceTypeVS (JSON-LD structure)",
                "properties": {
                  "@type": {
                    "type": "string",
                    "const": "http://smart.who.int/base/ValueSet-KGEvidenceTypeVS.jsonld",
                    "description": "JSON-LD type reference to ValueSet KGEvidenceTypeVS"
                  },
                  "@id": {
                    "type": "string",
                    "format": "uri",
                    "description": "Full IRI of the code from ValueSet KGEvidenceTypeVS"
                  }
                },
                "required": [
                  "@type",
                  "@id"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Which kind of evidence a row is, and so which scale its certainty is on: GRADE for effects, GRADE-CERQual for qualitative findings."
          },
          "certainty": {
            "oneOf": [
              {
                "type": "string",
                "description": "Code from ValueSet KGCertaintyVS (plain string)"
              },
              {
                "type": "object",
                "description": "Code from ValueSet KGCertaintyVS (JSON-LD structure)",
                "properties": {
                  "@type": {
                    "type": "string",
                    "const": "http://smart.who.int/base/ValueSet-KGCertaintyVS.jsonld",
                    "description": "JSON-LD type reference to ValueSet KGCertaintyVS"
                  },
                  "@id": {
                    "type": "string",
                    "format": "uri",
                    "description": "Full IRI of the code from ValueSet KGCertaintyVS"
                  }
                },
                "required": [
                  "@type",
                  "@id"
                ],
                "additionalProperties": false
              }
            ],
            "description": "GRADE certainty of evidence."
          },
          "summary": {
            "type": "string",
            "description": "Summary of the body of evidence."
          },
          "studyCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of studies in the body of evidence."
          },
          "citation": {
            "type": "string",
            "description": "Bibliographic citation of the evidence review."
          },
          "contentHash": {
            "type": "string",
            "description": "sha256 of the normalised summary."
          }
        },
        "required": [
          "resourceType"
        ],
        "resourceDefinition": "http://smart.who.int/base/StructureDefinition/KGEvidence",
        "fhir:parent": "http://hl7.org/fhir/StructureDefinition/Base",
        "jsonld:valuesets": [
          "KGCertaintyVS",
          "KGEvidenceTypeVS"
        ],
        "jsonld:contextTemplate": {
          "@version": 1.1,
          "fhir": "http://hl7.org/fhir/",
          "KGCertaintyVS": "http://smart.who.int/base/ValueSet-KGCertaintyVS.jsonld",
          "KGEvidenceTypeVS": "http://smart.who.int/base/ValueSet-KGEvidenceTypeVS.jsonld"
        }
      }
    }
  }
}