{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/base/StructureDefinition-KGHealthIntervention.schema.json",
  "title": "Knowledge graph L1: Health intervention",
  "description": "An intervention identified in a WHO catalogue or classification (UHC Compendium, ICHI, CDHI), digital interventions included. A peer of recommendation, not a recommendation. A DAK may draw on both. Corresponds to HealthInterventions: identifier and description correspond to HealthInterventions.id and description[x]; not a Parent because HealthInterventions requires reference 1..* DublinCore, which here is an edge (definedIn) rather than a field. Class IRI: http://smart.who.int/kg/health-intervention.",
  "type": "object",
  "properties": {
    "resourceType": {
      "type": "string",
      "const": "KGHealthIntervention",
      "description": "Resource type identifier for KGHealthIntervention logical model"
    },
    "@context": {
      "description": "JSON-LD context for this logical model with ValueSet vocabularies",
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "description": "URI reference to external JSON-LD context"
        },
        {
          "type": "object",
          "description": "Inline JSON-LD context",
          "properties": {
            "@version": {
              "type": "number",
              "const": 1.1
            },
            "fhir": {
              "type": "string",
              "const": "http://hl7.org/fhir/"
            }
          },
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        },
        {
          "type": "array",
          "description": "Array of JSON-LD context objects/URIs",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      ]
    },
    "@type": {
      "type": "string",
      "description": "JSON-LD type identifier for KGHealthIntervention logical model",
      "examples": [
        "LogicalModel-KGHealthIntervention"
      ]
    },
    "identifier": {
      "type": "string",
      "description": "The catalogue code (UHC, ICHI, CDHI)."
    },
    "name": {
      "type": "string",
      "description": "Name, as catalogued."
    },
    "description": {
      "type": "string",
      "description": "Description, as catalogued."
    },
    "interventionType": {
      "oneOf": [
        {
          "type": "string",
          "description": "Code from ValueSet KGInterventionTypeVS (plain string)"
        },
        {
          "type": "object",
          "description": "Code from ValueSet KGInterventionTypeVS (JSON-LD structure)",
          "properties": {
            "@type": {
              "type": "string",
              "const": "http://smart.who.int/base/ValueSet-KGInterventionTypeVS.jsonld",
              "description": "JSON-LD type reference to ValueSet KGInterventionTypeVS"
            },
            "@id": {
              "type": "string",
              "format": "uri",
              "description": "Full IRI of the code from ValueSet KGInterventionTypeVS"
            }
          },
          "required": [
            "@type",
            "@id"
          ],
          "additionalProperties": false
        }
      ],
      "description": "DRAFT."
    }
  },
  "required": [
    "resourceType"
  ],
  "resourceDefinition": "http://smart.who.int/base/StructureDefinition/KGHealthIntervention",
  "fhir:parent": "http://hl7.org/fhir/StructureDefinition/Base",
  "jsonld:valuesets": [
    "KGInterventionTypeVS"
  ],
  "jsonld:contextTemplate": {
    "@version": 1.1,
    "fhir": "http://hl7.org/fhir/",
    "KGInterventionTypeVS": "http://smart.who.int/base/ValueSet-KGInterventionTypeVS.jsonld"
  }
}