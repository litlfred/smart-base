{
  "openapi": "3.1.0",
  "info": {
    "title": "Knowledge graph L1: Evidence API",
    "description": "The body of evidence behind a recommendation, with its GRADE certainty rating. Class IRI: http://smart.who.int/kg/evidence.",
    "version": "1.0.0"
  },
  "paths": {
