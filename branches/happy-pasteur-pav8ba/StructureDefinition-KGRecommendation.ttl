       fhir:index 0 ;
       fhir:Element.id [ fhir:value "KGRecommendation" ] ;
       fhir:ElementDefinition.path [ fhir:value "KGRecommendation" ] ;
       fhir:ElementDefinition.short [ fhir:value "Knowledge graph L1: Recommendation" ] ;
       fhir:ElementDefinition.definition [ fhir:value "A normative statement from a WHO guideline. Kinds other than a graded recommendation (context-specific, research-only, good practice statement, no-recommendation) are the same node with a different kind. statement is verbatim and is the only stored copy. intervention, population, setting, provider and timing are verbatim slots taken from the statement, its remarks, or the enclosing caption or heading. setting absorbs the former conditionality. identifier is the published number (e.g. A.1.1), used in the IRI; sub-recommendations append their letter. Class IRI: http://smart.who.int/kg/recommendation." ]
     ], [
       fhir:index 1 ;
